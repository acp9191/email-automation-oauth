# ---------------------------------------------------------------------------
# Personal Email Automation — example configuration
# Copy to `.env` and fill in.  NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Safety -----------------------------------------------------------------
# While true, the system reads Gmail and downloads bills but NEVER sends email.
# Leave this as `true` until you have watched a full dry run succeed.
DRY_RUN=true

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=info
# Human-readable logs for local dev; set false in Docker for JSON lines.
LOG_PRETTY=true

# --- Storage ----------------------------------------------------------------
# All local state (SQLite db, OAuth tokens, downloaded bills) lives here.
DATA_DIR=./data

# --- Google OAuth -----------------------------------------------------------
# Create an OAuth 2.0 Client ID of type "Desktop app" in Google Cloud Console.
# See README "Gmail OAuth setup".  These are NOT passwords, but keep them secret.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Loopback port used by the interactive `npm run auth` flow.
GOOGLE_OAUTH_PORT=4141

# --- Gmail scanning ---------------------------------------------------------
# How far back `npm run scan` looks, and how many messages it will consider.
GMAIL_LOOKBACK_DAYS=30
GMAIL_MAX_RESULTS=25

# --- Verizon bill reimbursement workflow ------------------------------------
# The ONLY address the system is allowed to send reimbursement email to.
# There is no other way to set the recipient; it is never taken from an email.
WORK_EMAIL=

# Domains the browser automation is permitted to navigate to (comma separated).
# Anything not on this list is refused.
VERIZON_ALLOWED_DOMAINS=verizon.com,www.verizon.com,secure.verizon.com

# --- Failure notifications --------------------------------------------------
# Where failure notices go. Defaults to the authenticated Gmail account.
NOTIFY_EMAIL=

# --- Event source (polling) -------------------------------------------------
# How often `npm run watch` re-checks Gmail, in seconds.
POLL_INTERVAL_SECONDS=900

# --- Verizon portal (Playwright) --------------------------------------------
# The bill lives behind a My Verizon login. Verizon rejects automated sign-in
# and serves headless browsers a blank page, so `run-verizon --interactive`
# opens a real window, you sign in once (~30s), and the rest is automatic.
# NO VERIZON PASSWORD IS STORED ANYWHERE BY THIS APPLICATION.
VERIZON_BILLING_URL=https://www.verizon.com/mybill/#/billhome
VERIZON_NAV_TIMEOUT_MS=45000

# --- Host capability --------------------------------------------------------
# Set false on a headless machine (a VM). Verizon requires a human at a real
# browser, so a GUI-less host detects the bill and notifies you instead of
# failing obscurely. The browser step then runs on your workstation.
BROWSER_ENABLED=true
